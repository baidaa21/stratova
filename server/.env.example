# Copy to .env values into your process manager / shell. Never commit real secrets.
PORT=3000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=true            # true when served over HTTPS
# Initial passwords (used only on the very first start, when the database is created)
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-strong-password
DETAILING_PASSWORD=choose-a-strong-password
AUTOSTUDIO_PASSWORD=choose-a-strong-password
# DATA_DIR=/var/lib/stratova
